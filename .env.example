# Copy to .env for local development. .env is gitignored.
# In production these are Amplify → Hosting → Environment variables.

# "true" only at cut-over. Unset = every page noindex, robots.txt disallows
# everything, no analytics tags load (safe for the Amplify preview).
# PUBLIC_LAUNCHED=

# lead-intake Lambda Function URL (lambda/lead-intake/README.md). Unset = forms
# report an error instead of pretending to send.
# PUBLIC_LEAD_ENDPOINT_URL=

# Analytics counters (defaults: the WP site's Метрика 97147329 and GA4
# G-KPNZ32WW2F). Set to an empty string to disable one.
# PUBLIC_YM_ID=
# PUBLIC_GA4_MEASUREMENT_ID=
