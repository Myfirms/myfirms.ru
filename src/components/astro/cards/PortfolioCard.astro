---
/** Portfolio case card: cover, category chip, title, "Читать »". */
import { Image } from 'astro:assets';
import { asset } from '../../../lib/assets';

interface Props {
  href: string;
  title: string;
  image: string;
  category?: string;
  headingLevel?: 'h2' | 'h3';
}

const { href, title, image, category, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class="card">
  <div class="media">
    <Image src={asset(image)} alt="" widths={[360, 540]} sizes="(max-width: 767px) 100vw, 360px" />
    {category && <span class="chip">{category}</span>}
  </div>
  <div class="body">
    <H class="card-title"><a href={href}>{title}</a></H>
    <span class="more" aria-hidden="true">Читать »</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--transition),
      transform var(--transition);
  }

  .card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }

  .media {
    position: relative;
  }

  .media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .chip {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--navy-950);
    color: var(--white);
    font: 700 12px/1.4 var(--font-display);
    text-transform: uppercase;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    padding: 26px 22px 22px;
  }

  .card-title {
    font: 500 20px/1.3 var(--font-sans);
    letter-spacing: 0;
    color: var(--blue-400);
  }

  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .more {
    margin-top: auto;
    font: 700 12px/1 var(--font-display);
    text-transform: uppercase;
    color: var(--blue-400);
  }
</style>
