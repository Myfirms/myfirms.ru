---
import Button from '../components/astro/foundation/Button.astro';
import Section from '../components/astro/foundation/Section.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const crumbs = [
  { label: 'Главная', href: '/' },
  { label: 'Страница не найдена', href: '/404/' },
];
---

<SiteLayout seo={{ title: 'Страница не найдена — MyFirms', description: 'Такой страницы нет. Перейдите на главную или в каталог услуг.' }} h1="Страница не найдена" crumbs={crumbs}>
  <Section background="white">
    <div class="box">
      <p>Возможно, страница была перемещена или адрес набран с ошибкой.</p>
      <div class="actions">
        <Button href="/">На главную</Button>
        <Button href="/marketing/" variant="accent">Услуги по маркетингу</Button>
      </div>
    </div>
  </Section>
</SiteLayout>

<style>
  .box {
    display: grid;
    justify-items: center;
    gap: var(--gap-lg);
    text-align: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-md);
  }
</style>
