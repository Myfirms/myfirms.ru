---
import Blocks from '../components/astro/blocks/Blocks.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pagesRepository } from '../lib/repository';

const home = (await pagesRepository.getAll()).find((p) => p.data.path === '/');
if (!home) throw new Error('Homepage content (src/content/pages/home.json) is missing');
---

<SiteLayout seo={home.data.seo}>
  <Blocks blocks={home.data.blocks} />
</SiteLayout>
